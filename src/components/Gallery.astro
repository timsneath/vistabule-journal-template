---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  photos: { img: ImageMetadata; caption: string }[];
  heading?: string;
}

const { title, photos, heading = 'Photos' } = Astro.props;

// Build a larger (but still optimized) version of each photo for the lightbox.
const items = await Promise.all(
  photos.map(async (p, i) => ({
    img: p.img,
    caption: p.caption,
    index: i,
    alt: p.caption || `Photo from ${title}`,
    full: (await getImage({ src: p.img, width: 1600, format: 'webp' })).src,
  }))
);
---

{
  items.length > 0 && (
    <>
      <div class="section-head">
        <h2>{heading}</h2>
        <span class="rule" />
      </div>

      <div class="gallery">
        {items.map((p) => (
          <figure class="gallery__cell">
            <button
              class="gallery__item"
              type="button"
              data-full={p.full}
              data-caption={p.caption}
              aria-label={`View “${p.alt}” full screen`}
            >
              <Image
                class="gallery__img"
                src={p.img}
                alt={p.alt}
                widths={[320, 640]}
                sizes="(max-width: 600px) 100vw, 320px"
              />
              <span class="gallery__expand" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8 3H3v5M16 3h5v5M16 21h5v-5M8 21H3v-5" />
                </svg>
              </span>
            </button>
            {p.caption && <figcaption>{p.caption}</figcaption>}
          </figure>
        ))}
      </div>

      <dialog class="lightbox" aria-label="Photo viewer">
        <button class="lb-btn lb-close" type="button" data-act="close" aria-label="Close">✕</button>
        <button class="lb-btn lb-prev" type="button" data-act="prev" aria-label="Previous photo">‹</button>
        <button class="lb-btn lb-next" type="button" data-act="next" aria-label="Next photo">›</button>
        <figure class="lightbox__stage">
          <img class="lightbox__img" alt="" />
          <figcaption class="lightbox__caption" />
        </figure>
      </dialog>
    </>
  )
}

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  if (dialog) {
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('.gallery__item')];
    const imgEl = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
    const capEl = dialog.querySelector<HTMLElement>('.lightbox__caption')!;
    let current = 0;

    const show = (n: number) => {
      current = (n + buttons.length) % buttons.length;
      const btn = buttons[current];
      imgEl.src = btn.dataset.full || '';
      imgEl.alt = btn.dataset.caption || '';
      const cap = btn.dataset.caption || '';
      capEl.textContent = cap;
      capEl.style.display = cap ? '' : 'none';
    };

    buttons.forEach((btn, idx) =>
      btn.addEventListener('click', () => {
        show(idx);
        dialog.showModal();
      })
    );

    dialog.addEventListener('click', (e) => {
      const act = (e.target as HTMLElement).closest<HTMLElement>('[data-act]')?.dataset.act;
      if (act === 'next') show(current + 1);
      else if (act === 'prev') show(current - 1);
      else if (act === 'close' || e.target === dialog) dialog.close();
    });

    document.addEventListener('keydown', (e) => {
      if (!dialog.open) return;
      if (e.key === 'ArrowRight') show(current + 1);
      else if (e.key === 'ArrowLeft') show(current - 1);
    });
  }
</script>

<style>
  .gallery {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
  }
  .gallery__cell {
    margin: 0;
  }
  .gallery__item {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    padding: 0;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--canvas);
    box-shadow: var(--shadow);
    cursor: zoom-in;
    transition: border-color 0.16s ease, box-shadow 0.16s ease;
  }
  .gallery__item:hover {
    border-color: var(--loon);
    box-shadow: var(--shadow-lift);
  }
  .gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .gallery__item:hover .gallery__img {
    transform: scale(1.05);
  }
  .gallery__expand {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 8px;
    background: rgba(21, 36, 47, 0.62);
    color: var(--paper);
    opacity: 0;
    transform: translateY(-3px);
    transition: opacity 0.16s ease, transform 0.16s ease;
  }
  .gallery__item:hover .gallery__expand,
  .gallery__item:focus-visible .gallery__expand {
    opacity: 1;
    transform: translateY(0);
  }
  .gallery figcaption {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--ink-soft);
    margin-top: 0.45rem;
  }

  /* lightbox */
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: 100vw;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    overflow: hidden;
  }
  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox::backdrop {
    background: rgba(15, 26, 34, 0.86);
    backdrop-filter: blur(3px);
  }
  .lightbox__stage {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    pointer-events: none;
  }
  .lightbox__img {
    max-width: 92vw;
    max-height: 80dvh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 10px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
    background: var(--lake);
  }
  .lightbox__caption {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--paper);
    text-align: center;
    max-width: 60ch;
  }
  .lb-btn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border: none;
    border-radius: 50%;
    background: rgba(241, 239, 232, 0.14);
    color: var(--paper);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .lb-btn:hover {
    background: rgba(241, 239, 232, 0.28);
  }
  .lb-close {
    top: 1.1rem;
    right: 1.1rem;
    font-size: 1.15rem;
  }
  .lb-prev {
    left: 1.1rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-next {
    right: 1.1rem;
    top: 50%;
    transform: translateY(-50%);
  }
  @media (max-width: 34rem) {
    .lb-prev {
      left: 0.5rem;
    }
    .lb-next {
      right: 0.5rem;
    }
  }
</style>
